# Port the server listens on
PORT=3000

# Secret used to sign session cookies - change this to a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Path to the sqlite database file (created automatically on first run)
DB_FILE=./data/poker.db

# Dev/testing only: skip login, each browser tab joins as its own guest player.
# Never set this in a deployed build - it bypasses login entirely. The server
# throws on startup if it is `true` while NODE_ENV=production.
SKIP_AUTH=false

# Domain for the synthetic login addresses usernames are mapped to. The forms
# ask for a username and never an email; `nik` becomes nik@<this domain>.
# Nothing is ever sent to it, so it must not be a domain that could receive
# mail - `.internal` is reserved for exactly this.
VITE_AUTH_EMAIL_DOMAIN=bbp.internal

# --- Supabase guest accounts -------------------------------------------------
# Left blank, the game falls back to SKIP_AUTH guest naming and needs no
# internet at all. Filled in, every visitor gets an anonymous Supabase account
# and the socket handshake is checked against it.
#
# The two VITE_ values are read at build time and end up in the bundle, which
# is what the anon key is for. Turn on "Allow anonymous sign-ins" under
# Authentication > Sign In / Providers, and apply supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server side, for verifying the token a socket connects with. The JWT secret
# (Project Settings > API > JWT keys, legacy HS256) verifies locally with no
# network call, which is the faster path; URL + anon key is the fallback.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
