# Port the server listens on
PORT=3000

# Secret used to sign session cookies - change this to a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Path to the sqlite database file (created automatically on first run)
DB_FILE=./data/poker.db

# Dev/testing only: skip login, each browser tab joins as its own guest player
SKIP_AUTH=false
